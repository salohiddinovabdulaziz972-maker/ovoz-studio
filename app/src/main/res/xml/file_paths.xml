<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider ko'rsatadigan papkalar. Faqat TAYYOR NATIJALAR: kesh papkasidagi
  `natija/`. Manba nusxalari, oraliq fayllar va jurnal papkasi bu yerda yo'q —
  ular boshqa ilovaga hech qachon berilmaydi.

  Natija ulashilgach qabul qiluvchi ilova uni keyinroq ham o'qishi mumkin
  (masalan xabar yuboruvchi ilova orqa fonda yuklaydi), shuning uchun natijalar
  ekran yopilganda o'chirilmaydi: ularni `WorkStore.sweep` bir kundan keyin
  tozalaydi.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="natija"
        path="natija/" />
</paths>
