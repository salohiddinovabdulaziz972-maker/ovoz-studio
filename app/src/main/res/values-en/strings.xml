    <string name="noise_error_sample_quiet">The selected sample is silent — choose a part where only noise is heard</string>

    <string name="voice_title">Voice check</string>
    <string name="voice_hint">This screen checks the device voice: which voices exist, whether an Uzbek one is present, and whether long text is split correctly. Type the text or paste a passage and press “Read”.</string>
    <string name="voice_text_label">Text to read</string>
    <string name="voice_text_note">Long text is split into parts automatically, and the parts are read one after another.</string>
    <string name="voice_rate_label">Reading speed</string>
    <string name="voice_rate_note">From %1$s to %2$s. 1 — normal speed, 2 — twice as fast, 0.5 — twice as slow.</string>
    <string name="voice_pitch_label">Pitch, semitones</string>
    <string name="voice_pitch_note">Semitones set how high or low the voice sounds: 12 — one octave up, -12 — one octave down. 0 — unchanged.</string>
