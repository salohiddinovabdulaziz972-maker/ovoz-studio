    <string name="noise_title">Noise reduction</string>
    <string name="noise_hint">No file selected. To remove noise, open an audio file first.</string>
    <string name="noise_sample_title">Noise sample</string>
    <string name="noise_sample_note">Mark a part where only noise is heard — usually the start of the recording, before anyone speaks. The app measures the noise level in that part and subtracts it from the whole file.</string>
    <string name="noise_sample_from">Sample start</string>
    <string name="noise_sample_to">Sample end</string>
    <string name="noise_sample_range">Sample range: %1$s — %2$s</string>
    <string name="noise_strength_label">Reduction strength</string>
    <string name="noise_strength_note">From 1.0 to %1$s. A higher value suppresses noise more deeply, but a very high value can also muffle the quiet parts of speech.</string>
    <string name="noise_floor_label">Residual, dB</string>
    <string name="noise_floor_note">How much power is left in the noise bands after subtraction: at -30 almost nothing remains, at -3 a noticeable amount does. At a very low value the remainder is heard as random tones.</string>
    <string name="noise_action">Apply and save</string>
    <string name="noise_busy">Reducing noise, please wait…</string>
    <string name="noise_done">Saved: %1$s — noise reduced by %2$s dB</string>
    <string name="noise_open_saved">Open in the trim screen</string>
    <string name="noise_error_file_not_found">File not found</string>
    <string name="noise_error_edit_failed">Could not reduce the noise</string>
    <string name="noise_error_sample_range">The sample range is invalid: the end must come after the start</string>
    <string name="noise_error_sample_quiet">The selected sample is silent — choose a part where only noise is heard</string>

    <string name="stem_title">Separate vocals and instruments</string>
    <string name="stem_hint">Pick a file: in a stereo recording the vocals are taken from the centre and the instruments from the sides.</string>
    <string name="stem_stereo_only">This is a channel method: vocals usually sit in the centre and instruments at the sides. So only stereo works — a mono recording has nothing to separate, and the app says so plainly.</string>
    <string name="stem_mode_label">Mode</string>
    <string name="stem_mode_split">Separate (partial)</string>
    <string name="stem_mode_remove">Remove vocals (exact subtraction)</string>
    <string name="stem_mode_note_split">Each band is subtracted according to how much it belongs to the centre: vocals in the centre are removed, a wide instrument is kept.</string>
    <string name="stem_mode_note_remove">The centre is subtracted completely: the vocals disappear and no artificial sound is added.</string>
    <string name="stem_strength_label">Separation strength</string>
    <string name="stem_strength_note">A higher value keeps more of the instrument, a lower one removes the vocals more fully.</string>
    <string name="stem_strength_unused">Strength is not used in this mode: the centre is subtracted completely.</string>
    <string name="stem_action">Separate</string>
    <string name="stem_busy">Separating, one moment…</string>
    <string name="stem_done">Done: vocals and instrumental saved as separate files</string>
    <string name="stem_saved_vocal">Vocals: %1$s</string>
    <string name="stem_saved_instrumental">Instrumental: %1$s</string>
    <string name="stem_side_ratio">Side part relative to the centre: %1$s dB</string>
    <string name="stem_nearly_mono">Careful: the side part of the source is very weak, so the vocals and the instrument sit almost in the same place. The separation ran, but the difference may be inaudible.</string>
    <string name="stem_open_vocal">Open the vocals</string>
    <string name="stem_open_instrumental">Open the instrumental</string>
    <string name="stem_error_file_not_found">File not found or unreadable</string>
    <string name="stem_error_not_stereo">This file is not stereo. In a single channel the centre and the sides cannot be told apart, so the method needs a stereo recording.</string>
    <string name="stem_error_mono_content">Both channels of the file are identical, so the content is mono. There is nothing to separate in such a recording.</string>
    <string name="stem_error_edit_failed">Could not separate: error reading or writing the file</string>

