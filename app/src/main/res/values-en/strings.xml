    <string name="speed_title">Speed and pitch</string>
    <string name="speed_hint">No file selected. Open an audio file first to change its speed and pitch.</string>
    <string name="speed_label">Speed</string>
    <string name="speed_note">A value above 1 speeds the audio up, below 1 slows it down: 2 — twice as fast, 0.5 — twice as slow. The pitch does not change. The value ranges from 0.5 to 2.0.</string>
    <string name="speed_pitch_label">Pitch, semitones</string>
    <string name="speed_pitch_note">Semitones change how high the sound is and leave its length untouched: 12 — one octave up, -12 — one octave down.</string>
