    <string name="noise_floor_label">Qoldiq, dB</string>
    <string name="noise_floor_note">Ayirishdan keyin shovqin polosasida shuncha quvvat qoldiriladi: -30 da deyarli hech narsa qolmaydi, -3 da sezilarli qoladi. Juda past qiymatda qoldiq tasodifiy ohanglar bo\'lib eshitiladi.</string>
