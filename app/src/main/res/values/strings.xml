    <string name="stem_title">Vokal va cholg\'uni ajratish</string>
    <string name="stem_hint">Fayl tanlang: stereo yozuvdagi vokal markazdan, cholg\'u yonlardan olinadi.</string>
    <string name="stem_stereo_only">Usul kanal usuli: vokal odatda markazda, cholg\'u yonlarda turadi. Shu sababli faqat stereo fayl yaroqli — mono yozuvda ajratadigan narsa yo\'q va ilova buni ochiq aytadi.</string>
    <string name="stem_mode_label">Rejim</string>
    <string name="stem_mode_split">Ajratish (qismiy)</string>
    <string name="stem_mode_remove">Vokalni o\'chirish (aniq ayirish)</string>
    <string name="stem_mode_note_split">Har bir polosa markazga qanchalik xos ekaniga qarab olinadi: markazda turgan vokal o\'chadi, keng yozilgan cholg\'u saqlanadi.</string>
    <string name="stem_mode_note_remove">Markaz butunlay ayiriladi: vokal butunlay o\'chadi va natijada sun\'iy tovush bo\'lmaydi.</string>
    <string name="stem_strength_label">Ajratish kuchi</string>
    <string name="stem_strength_note">Katta qiymatda cholg\'u ko\'proq saqlanadi, kichigida vokal to\'liqroq o\'chadi.</string>
    <string name="stem_strength_unused">Bu rejimda kuch ishlatilmaydi: markaz butunlay olinadi.</string>
