<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ilova internetga chiqmaydi (INTERNET ruxsati yo'q). Fayllar ochiq
         `ACTION_OPEN_DOCUMENT` orqali o'qiladi — buning uchun ruxsat kerak
         emas: foydalanuvchi tanlagan fayl ilovaga o'sha zahoti ochiladi.

         Natija esa MediaStore orqali qurilmaning umumiy papkasiga yoziladi.
         Android 10 (API 29) va undan yuqorisida ilova o'zi yaratgan yozuvni
         ruxsatsiz yozadi — shuning uchun bu ruxsat faqat eski tizimlar
         uchun e'lon qilingan. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Zaxira nusxa (bulut va `adb backup`) O'CHIRILGAN. Ilova foydalanuvchining
         shaxsiy fayllari (audio, PDF, hujjat) bilan ishlaydi — ular o'z-o'zidan
         bulutga yoki kompyuterga chiqib ketmasligi kerak. -->
    <application
        android:name=".OvozApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OvozStudio">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OvozStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fayl ulashish uchun. Android 7+ da `file://` yo'l boshqa ilovaga
             berilmaydi (FileUriExposedException), faqat `content://` havola
             mumkin — uni shu provayder yasaydi. `exported=false`: boshqa
             ilovalar provayderni o'zi chaqira olmaydi, havola esa faqat
             ulashish paytida, bir marta beriladi. Qaysi papka ko'rinishini
             `res/xml/file_paths.xml` belgilaydi (faqat tayyor natijalar). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
