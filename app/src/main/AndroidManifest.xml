<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Faqat mikrofon. Fayllar ilovaning o'z papkasida saqlanadi, shuning uchun
         ommaviy xotirani o'qish ruxsati SO'RALMAYDI: keraksiz ruxsat —
         foydalanuvchi uchun xavf va ishonchsizlik. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Yozuv ekran o'chganda ham davom etishi uchun. `FOREGROUND_SERVICE_MICROPHONE`
         Android 14+ da majburiy; eski versiyalar uni shunchaki tanimaydi. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Yozuv bildirishnomasi ko'rinishi uchun (Android 13+). Ruxsat berilmasa
         ham yozuv ishlaydi — faqat bildirishnoma ko'rinmaydi. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Mikrofon bo'lmasa ham ilova o'rnatiladi: tahrirlash qismi ishlayveradi. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Android 11 (API 30) dan boshlab ilova o'zi ko'rmaydigan xizmatlarni
         so'ray olmaydi. Ovoz sintezatori — aynan shunday tashqi xizmat:
         usiz `TextToSpeech` ovozlar ro'yxatini bo'sh qaytaradi va o'zbek
         ovozi bor-yo'qligini bilib bo'lmaydi. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OvozStudio">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OvozStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Yozuv davomida jarayonni tirik ushlab turadi. Chaqiruvchi faqat
             ilovaning o'zi, shuning uchun `exported=false`. -->
        <service
            android:name=".media.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Fayl ulashish uchun. Android 7+ da `file://` yo'l boshqa ilovaga
             berilmaydi (FileUriExposedException), faqat `content://` havola
             mumkin — uni shu provayder yasaydi. `exported=false`: boshqa
             ilovalar provayderni o'zi chaqira olmaydi, havola esa faqat
             ulashish paytida, bir marta beriladi. Qaysi papkalar
             ko'rinishini `res/xml/file_paths.xml` belgilaydi. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
